# Set false to temporarily disable Prism HTTP authentication and hide console token controls.
PRISM_SERVICE_AUTH_ENABLED=true
# Service access token (independent from upstream model API keys).
AI_SERVICE_API_KEY=

# Required for database-backed model definitions and extraction history.
# Use only the lumenx_prism database and prism_app user.
# URL-encode the password and keep actual credentials in private .env.
PRISM_MONGODB_URI=
PRISM_MONGODB_DATABASE=lumenx_prism
# mongodb://prism_app:<URL_ENCODED_PASSWORD>@<mongo-host>:27017/lumenx_prism?authSource=lumenx_prism

# Model API keys, base URLs, IDs and parameters are managed at /tools/models
# and stored in model_comfigs. Runtime ignores legacy OPENAI_*, DASHSCOPE_*
# and LLM_PROVIDER variables; no model-env fallback is performed.
