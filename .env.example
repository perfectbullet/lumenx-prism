LLM_PROVIDER=dashscope
DASHSCOPE_API_KEY=
# Optional provider base override; /compatible-mode/v1 is added by the adapter.
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
# For other OpenAI-compatible providers:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=your-model
# Set a private service token before exposing this API beyond loopback.
AI_SERVICE_API_KEY=

# Reserved dedicated MongoDB container (not used by the stateless entity endpoint).
PRISM_MONGO_ROOT_USERNAME=prism_admin
PRISM_MONGO_ROOT_PASSWORD=
PRISM_MONGO_APP_PASSWORD=
PRISM_MONGO_PORT=27019
# Future application connection. Use this dedicated instance/user only.
# PRISM_MONGODB_URI=mongodb://prism_app:<URL_ENCODED_PASSWORD>@127.0.0.1:27019/lumenx_prism?authSource=lumenx_prism
# PRISM_MONGODB_DATABASE=lumenx_prism
