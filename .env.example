LLM_PROVIDER=dashscope
DASHSCOPE_API_KEY=
# Optional provider base override; /compatible-mode/v1 is added by the adapter.
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
# For other OpenAI-compatible providers:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=your-model
# Set a private service token before exposing this API beyond loopback.
AI_SERVICE_API_KEY=

# Optional inference experiment history in the existing MongoDB instance.
# Credentials are independent; use only the lumenx_prism database and prism_app user.
# URL-encode the password. Keep actual values in this project's private .env.
PRISM_MONGODB_URI=
PRISM_MONGODB_DATABASE=lumenx_prism
# URI shape: mongodb://prism_app:<URL_ENCODED_PASSWORD>@<mongo-host>:27017/lumenx_prism?authSource=lumenx_prism
